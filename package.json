{
  "name": "lotwork",
  "version": "1.0.0",
  "description": "Local dev project manager - start/stop projects, manage ports, custom localhost domains via Caddy",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "build": "pkg server.js --targets node22.23.2-win-x64 --output dist/lotwork-server.exe"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.22.0"
  },
  "pkg": {
    "assets": ["public/**/*"]
  }
}
