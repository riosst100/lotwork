{"nodes": [{"id": "readme_lotwork", "label": "lotwork (Local Docker Compose Dashboard)", "file_type": "document", "source_file": "README.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_electron_desktop_app", "label": "Electron Desktop App + System Tray", "file_type": "concept", "source_file": "README.md", "source_location": "L18", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Closing window only hides to tray so projects keep running; single-instance focuses existing window; server runs inside app so no separate start/stop."}, {"id": "readme_setup_bat", "label": "Setup.bat Installer", "file_type": "concept", "source_file": "README.md", "source_location": "L9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One-time setup: installs deps, brands Electron runtime as lotwork.exe so admin prompt/taskbar show lotwork, installs Caddy via winget, creates admin desktop shortcut."}, {"id": "readme_administrator_privileges", "label": "Run as Administrator", "file_type": "concept", "source_file": "README.md", "source_location": "L12", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Required to write the Windows hosts file and to start/stop Windows services."}, {"id": "readme_caddy_reverse_proxy", "label": "Caddy Reverse Proxy (tls internal)", "file_type": "concept", "source_file": "README.md", "source_location": "L96", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Generates data/Caddyfile mapping domain -> localhost:<container port> with automatic local HTTPS."}, {"id": "readme_custom_domains", "label": "Custom .local Domains", "file_type": "concept", "source_file": "README.md", "source_location": "L98", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Domain points to a container port chosen from compose-published ports; sync runs on startup and on project add/edit/delete."}, {"id": "readme_hosts_file_sync", "label": "Hosts File Managed Block", "file_type": "concept", "source_file": "README.md", "source_location": "L101", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Entries written inside a '# lotwork-managed-start/end' block so re-syncing is safe."}, {"id": "readme_docker_compose_projects", "label": "Docker Compose Projects in WSL", "file_type": "concept", "source_file": "README.md", "source_location": "L73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Start runs 'docker compose up -d' inside WSL so bind mounts/env files resolve as if run manually; Stop keeps containers for fast restart; Down removes containers but keeps volumes. Containers belong to Docker and survive quitting lotwork."}, {"id": "readme_wsl2", "label": "WSL 2", "file_type": "concept", "source_file": "README.md", "source_location": "L31", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Projects live in a WSL distro; git and shell commands run inside WSL, not with Windows tooling."}, {"id": "readme_docker_desktop", "label": "Docker Desktop (WSL integration)", "file_type": "concept", "source_file": "README.md", "source_location": "L32", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_compose_file_discovery", "label": "Compose File Discovery", "file_type": "concept", "source_file": "README.md", "source_location": "L43", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lists compose files in folder and one level below, reads via 'docker compose config'; ports come from compose so there is no port field; one compose project registered once."}, {"id": "readme_nextjs_allowed_dev_origins", "label": "Next.js allowedDevOrigins Auto-Patch", "file_type": "concept"